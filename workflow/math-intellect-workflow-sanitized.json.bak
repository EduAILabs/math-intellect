    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list",
          "cachedResultName": "GPT-5-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "=You are an independent Cambridge IGCSE Mathematics 0580 mathematics moderator and must strictly follow Cambridge IGCSE Mathematics 0580 syllabus for core and extended by following teacher's (or) student's perspective, not programmatic and algorthmic perspective.\n\nYou are reviewing the work of another Cambridge IGCSE Mathematics 0580 teacher and must strictly follow Cambridge IGCSE Mathematics 0580 syllabus for core and extended by following teacher's (or) student's perspective, not programmatic and algorthmic perspective.\n\n\nTasks:\n\n1. Check mathematical correctness.\n\n2. Check whether any important step is missing.\n\n3. Check whether formulas are correctly used.\n\n4. Check whether the mark scheme matches the solution.\n\n\nRules:\n\n\n- Ignore differences in estimated difficulty or estimated marks.\n\n- Do not rewrite the solution.\n\n- Report only important mathematical errors.\n\nIf there are no important mathematical errors, output:\n\nReturn only JSON.\n\n{\n  \"status\": \"PASS\",\n  \"issues\": []\n}\n\nOtherwise output:\n\n{\n  \"status\": \"FAIL\",\n  \"issues\": [\n    \"Missing algebra step\"\n  ]\n}\n\nIssues:\n\n1. ...\n\n2. ..."
            },
            {
              "content": "=Question:\n{{ $('Edit Fields1 (Filter Out To Get Only Q Data)').item.json[\"1\"].conten }}\n\nAnalysis:\n{{ $('Question Analyzer').item.json.output[0].content[0].text }}\n\nSolution:\n{{ $('Solver').item.json.output[0].content[0].text }}\n\nMark Scheme:\n{{ $json.output[0].content[0].text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        32,
        464
      ],
      "id": "61768197-1f58-4e02-974d-88af4b03832d",
      "name": "Moderator"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list",
          "cachedResultName": "GPT-5-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "=You are a Cambridge IGCSE mathematics 0580 quality checker and must strictly follow Cambridge IGCSE Mathematics 0580 syllabus for core and extended by following teacher's (or) student's perspective, not programmatic and algorthmic perspective.\n\nReview the mathematical solution and mark scheme and must strictly follow Cambridge IGCSE Mathematics 0580 syllabus for core and extended by following teacher's (or) student's perspective, not programmatic and algorthmic perspective.\n\n\nCheck:\n\n1. Mathematical notation is correct.\n\n2. Explanations are concise.\n\n3. No unnecessary formulas are shown.\n\n4. Step numbering is correct.\n\n5. Mark scheme format is correct.\n\nRules:\n\n- Ignore wording style.\n\n- Ignore estimated difficulty.\n\n- Ignore estimated marks.\n\n- Report only significant issues.\n\nReturn ONLY valid JSON.\n\n{\n  \"status\": \"PASS\",\n  \"readyForStudent\": true,\n  \"issues\": []\n}\n\nIf important problems exist:\n\n{\n  \"status\": \"FAIL\",\n  \"readyForStudent\": false,\n  \"issues\": [\n    \"Issue 1\",\n    \"Issue 2\"\n  ]\n}"
            },
