        "jsCode": "const token = $('Download Image').first().json.replyToken;\n\nreturn [{\n  json:{\n    replyToken:token,\n    formatted_output:'I could not verify this solution safely. Please resend a clearer question or ask your teacher to review it.'\n  }\n}];"
      },
