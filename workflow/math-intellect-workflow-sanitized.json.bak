      ],
      "id": "30c13dcb-6d22-41c0-bd57-31636822f201",
      "name": "Examiner"
    },
    {
      "parameters": {
        "url": "={{ \"https://api-data.line.me/v2/bot/message/\" + $json.messageId + \"/content\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
        "options": {}
