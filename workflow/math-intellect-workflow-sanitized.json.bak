    },
    {
      "parameters": {
        "jsCode": "//const analysis = $('Question Analyzer').first().json;\nconst analysisText = $('Question Analyzer').first().json.output[0].content[0].text;\n\nconst analysis = JSON.parse(analysisText);\n\nconst solution = $('Solver').first().json.output[0].content[0].text;\n\nconst examiner = $('Examiner').first().json.output[0].content[0].text;\n\nconst replyToken = $('Download Image').first().json.replyToken;\n\nconst output = `\nTopic: ${analysis.topic}\nDifficulty: ${analysis.difficulty}\nAssessment Objective: ${analysis.assessmentObjective}\n━━━━━━━━━━━━━━━━━━\nSolution\n\n${solution}\n━━━━━━━━━━━━━━━━━━\n${examiner}\n`;\n\nreturn [\n  {\n    json: {\n      replyToken,\n      formatted_output: output\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        432
      ],
      "id": "c494d954-34ee-4c29-9bc4-188c43e9954e",
      "name": "Formatter1"
    },
    {
      "parameters": {
